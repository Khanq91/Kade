<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <ImageView android:id="@+id/widget_bg_tint" android:layout_width="match_parent"
        android:layout_height="match_parent" android:contentDescription="@null"
        android:scaleType="fitXY" android:src="@drawable/widget_bg" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal">

    <FrameLayout android:layout_width="112dp" android:layout_height="match_parent">
        <TextView android:id="@+id/weekday" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:layout_marginTop="8dp" android:layout_marginEnd="5dp"
            android:ellipsize="end" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1"
            android:textColor="@color/widget_on_accent" android:textSize="10sp" android:text="Hôm nay" />
        <FrameLayout android:layout_width="70dp" android:layout_height="70dp"
            android:layout_gravity="bottom|start" android:background="@drawable/widget_solar_disc">
            <ImageView android:id="@+id/widget_disc_tint" android:layout_width="match_parent"
                android:layout_height="match_parent" android:contentDescription="@null"
                android:scaleType="fitXY" android:src="@drawable/widget_solar_disc" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/day" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:fontFamily="@font/baloo2" android:gravity="center" android:includeFontPadding="false"
                    android:textColor="@color/widget_text" android:textSize="34sp" android:textStyle="bold" android:text="--" />
                <TextView android:id="@+id/month" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:ellipsize="end" android:fontFamily="@font/be_vietnam_pro" android:gravity="center"
                    android:maxLines="1" android:textColor="@color/widget_text_secondary" android:textSize="8sp" android:text="Tháng" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|end" android:layout_marginEnd="7dp" android:layout_marginBottom="8dp"
            android:gravity="end" android:orientation="vertical">
            <TextView android:id="@+id/lunar_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro" android:text="@string/widget_lunar_label"
                android:textColor="@color/widget_on_accent" android:textSize="8sp" />
            <TextView android:id="@+id/lunar_day" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="@font/baloo2" android:includeFontPadding="false"
                android:textColor="@color/widget_on_accent" android:textSize="32sp" android:textStyle="bold" android:text="--" />
            <TextView android:id="@+id/lunar_month" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro" android:maxLines="1"
                android:textColor="@color/widget_on_accent" android:textSize="8sp" android:text="Tháng" />
            <TextView android:id="@+id/line5" android:layout_width="50dp" android:layout_height="wrap_content"
                android:ellipsize="end" android:fontFamily="@font/be_vietnam_pro" android:gravity="end"
                android:maxLines="1" android:textColor="@color/widget_on_accent" android:textSize="7sp" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:background="@drawable/widget_right_panel">
        <ImageView android:id="@+id/widget_panel_tint" android:layout_width="match_parent"
            android:layout_height="match_parent" android:contentDescription="@null"
            android:scaleType="fitXY" android:src="@drawable/widget_right_panel" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center_vertical" android:orientation="vertical"
            android:paddingStart="10dp" android:paddingTop="5dp" android:paddingEnd="7dp" android:paddingBottom="5dp">
        <LinearLayout android:id="@+id/up_row1" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/up_tag1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/widget_lunar_tag" android:fontFamily="@font/be_vietnam_pro" android:paddingStart="4dp" android:paddingEnd="4dp" android:textColor="@color/widget_accent_text" android:textSize="7sp" android:visibility="gone" />
                <TextView android:id="@+id/up_date1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:ellipsize="end" android:fontFamily="@font/baloo2" android:maxLines="1" android:textColor="@color/widget_accent_text" android:textSize="10sp" android:textStyle="bold" android:visibility="gone" />
                <TextView android:id="@+id/up_dot1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="9sp" android:visibility="gone" />
            </LinearLayout>
            <TextView android:id="@+id/up_title1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:text="@string/widget_no_upcoming" android:textColor="@color/widget_text" android:textSize="9sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/up_row2" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/up_tag2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/widget_lunar_tag" android:fontFamily="@font/be_vietnam_pro" android:paddingStart="4dp" android:paddingEnd="4dp" android:textColor="@color/widget_accent_text" android:textSize="7sp" />
                <TextView android:id="@+id/up_date2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:ellipsize="end" android:fontFamily="@font/baloo2" android:maxLines="1" android:textColor="@color/widget_accent_text" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/up_dot2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="9sp" />
            </LinearLayout>
            <TextView android:id="@+id/up_title2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:textColor="@color/widget_text" android:textSize="9sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/up_row3" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/up_tag3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/widget_lunar_tag" android:fontFamily="@font/be_vietnam_pro" android:paddingStart="4dp" android:paddingEnd="4dp" android:textColor="@color/widget_accent_text" android:textSize="7sp" />
                <TextView android:id="@+id/up_date3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:ellipsize="end" android:fontFamily="@font/baloo2" android:maxLines="1" android:textColor="@color/widget_accent_text" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/up_dot3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="9sp" />
            </LinearLayout>
            <TextView android:id="@+id/up_title3" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="@font/be_vietnam_pro" android:maxLines="1" android:textColor="@color/widget_text" android:textSize="9sp" />
        </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    </LinearLayout>
</FrameLayout>
